# Django
# For production set a random string of length >= 50 (required when DJANGO_DEBUG=False).
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production (docker-compose.prod.yml): the public hostname Caddy serves with
# automatic HTTPS. Also add it to DJANGO_ALLOWED_HOSTS, and its https:// origin
# to DJANGO_CSRF_TRUSTED_ORIGINS (needed for the /admin/ login).
# SITE_ADDRESS=judge.example.edu
# DJANGO_CSRF_TRUSTED_ORIGINS=https://judge.example.edu

# Database
POSTGRES_DB=judge_engine
POSTGRES_USER=judge
POSTGRES_PASSWORD=judge_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Judge limits
JUDGE_DEFAULT_TIME_LIMIT_MS=2000
JUDGE_DEFAULT_MEMORY_LIMIT_MB=256
# javac on a busy host can be slow; a timeout is retried as SystemError.
JUDGE_COMPILE_TIMEOUT_S=30
JUDGE_WALL_TIMEOUT_MULTIPLIER=3
JUDGE_SOURCE_MAX_BYTES=65536
# Max custom stdin for practice "Run".
JUDGE_STDIN_MAX_BYTES=16384
# Combined stdout+stderr per run; beyond this the run is killed (WrongAnswer).
JUDGE_OUTPUT_MAX_BYTES=4194304
JUDGE_IMAGE=eclipse-temurin:17-jdk-jammy
JUDGE_CONCURRENCY=4
# Workers for practice "Run" previews (separate queue; prod compose only).
JUDGE_PREVIEW_CONCURRENCY=2
# Judging/Pending longer than this counts as lost (worker crash, Redis restart)
# and the recovery sweep re-queues it. Keep it above JUDGE_TASK_SOFT_LIMIT_S.
JUDGE_STALE_SECONDS=900
# Max time for one judge task; past it the submission becomes SystemError.
JUDGE_TASK_SOFT_LIMIT_S=600

# Throttles
SUBMISSION_THROTTLE_RATE=12/min
# Login attempts per client IP (a lab behind NAT shares one address).
LOGIN_IP_THROTTLE_RATE=30/min
# Failed logins per username, across all IPs (the brute-force cap).
LOGIN_USER_THROTTLE_RATE=5/min
# Proxies in front of Django that append X-Forwarded-For: 1 for the Next.js
# frontend. Throttles key on the client IP these proxies report.
DRF_NUM_PROXIES=1

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set true behind HTTPS. In production NODE_ENV=production cookies default to Secure.
JWT_COOKIE_SECURE=false

# Bootstrap admin, created on startup if missing. Must not be a trivial
# password; production refuses this published dev default, so set your own.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=JudgeDev-Admin-ChangeMe!

# Dev only: the interface ports 3000/8000 listen on. Loopback by default
# (DEBUG is on and the admin password above is public); 0.0.0.0 opens them
# to the LAN.
# DEV_BIND=127.0.0.1

# Production backups (db-backup service): keep this many days of dumps,
# taken every BACKUP_INTERVAL_SECONDS.
# BACKUP_KEEP_DAYS=14
# BACKUP_INTERVAL_SECONDS=86400

# Host folder behind the workers' /judge_data mount (./judge_data). Leave unset:
# the worker detects it from its own container. Only set it, as an absolute
# path, if detection fails, e.g. C:/path/to/judge-engine/judge_data or
# /home/user/judge-engine/judge_data. Relative paths are rejected.
# JUDGE_HOST_DATA_DIR=
