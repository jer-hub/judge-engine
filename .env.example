# Django
# For production set a random string of length >= 50 (required when DJANGO_DEBUG=False).
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
POSTGRES_DB=judge_engine
POSTGRES_USER=judge
POSTGRES_PASSWORD=judge_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Judge limits
JUDGE_DEFAULT_TIME_LIMIT_MS=2000
JUDGE_DEFAULT_MEMORY_LIMIT_MB=256
JUDGE_COMPILE_TIMEOUT_S=10
JUDGE_WALL_TIMEOUT_MULTIPLIER=3
JUDGE_SOURCE_MAX_BYTES=65536
JUDGE_IMAGE=eclipse-temurin:17-jdk-jammy
JUDGE_CONCURRENCY=4

# Submission throttle
SUBMISSION_THROTTLE_RATE=12/min

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Set true behind HTTPS. In production NODE_ENV=production cookies default to Secure.
JWT_COOKIE_SECURE=false

# Bootstrap admin (compose). Must not be a trivial password.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=JudgeDev-Admin-ChangeMe!

# IMPORTANT: Set to absolute path for reliable Docker volume mounting.
# Windows example:  C:/path/to/judge-engine/judge_data
# Linux/macOS:      /home/user/judge-engine/judge_data
# The ./judge_data relative path may fail in Docker on Windows.
JUDGE_HOST_DATA_DIR=./judge_data
